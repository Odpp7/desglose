{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desglose",
  "version": "0.1.0",
  "identifier": "com.desglose.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Desglose",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#0a0d13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Desglose",
    "copyright": "Proyecto personal, uso libre",
    "category": "Music",
    "shortDescription": "Secuencias para equipos de alabanza",
    "longDescription": "Separa una canción en instrumentos, arma click, secciones y voz guía, y exporta el paquete para REAPER.",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "recursos/voz/": "voz/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
